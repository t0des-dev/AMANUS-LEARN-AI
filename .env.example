# ==============================================================================
# AMANUS LEARN AI - ENVIRONMENT VARIABLES
# ==============================================================================

# --- Global / Environment ---
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=django-insecure-amanus-learn-ai-dev-secret-key-change-in-production-!@#$
ALLOWED_HOSTS=localhost,127.0.0.1,web,api,nginx

# --- API & Frontend URLs ---
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL Database ---
POSTGRES_DB=amanus_learn_db
POSTGRES_USER=amanus_user
POSTGRES_PASSWORD=amanus_password_secure
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://amanus_user:amanus_password_secure@postgres:5432/amanus_learn_db

# --- Redis & Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- S3 / MinIO Storage ---
USE_MINIO=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_ENDPOINT=http://minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminpassword
AWS_STORAGE_BUCKET_NAME=amanus-documents
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# --- AI Providers (Sprint 00 Abstraction Placeholders) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_URL=http://localhost:11434

# --- Next.js Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Amanus Learn AI"
PORT=3000

# --- SaaS Billing & Quotas (Sprint 14) ---
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Production Security & Monitoring (Sprint 14) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://app.amanuslearn.com
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
RETENTION_DAYS=7
