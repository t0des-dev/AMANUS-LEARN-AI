# ==============================================================================
# AMANUS LEARN AI - STAGING ENVIRONMENT VARIABLES (.env.staging.example)
# ==============================================================================

# --- Global / Environment ---
ENVIRONMENT=staging
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.staging
SECRET_KEY=staging-django-secret-key-replace-with-secure-value-32chars
ALLOWED_HOSTS=staging.amanuslearn.com,api-staging.amanuslearn.com,localhost,api,web,nginx

# --- API & Frontend URLs ---
API_BASE_URL=https://api-staging.amanuslearn.com
FRONTEND_URL=https://staging.amanuslearn.com
CORS_ALLOWED_ORIGINS=https://staging.amanuslearn.com,http://localhost:3000

# --- PostgreSQL Database (Staging isolated) ---
POSTGRES_DB=amanus_staging_db
POSTGRES_USER=amanus_staging_user
POSTGRES_PASSWORD=amanus_staging_password_secure
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://amanus_staging_user:amanus_staging_password_secure@postgres:5432/amanus_staging_db

# --- Redis & Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_password_secure
REDIS_URL=redis://:staging_redis_password_secure@redis:6379/0
CELERY_BROKER_URL=redis://:staging_redis_password_secure@redis:6379/0
CELERY_RESULT_BACKEND=redis://:staging_redis_password_secure@redis:6379/1

# --- S3 / MinIO Storage ---
USE_MINIO=true
MINIO_ROOT_USER=staging_minio_admin
MINIO_ROOT_PASSWORD=staging_minio_password
MINIO_ENDPOINT=http://minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=staging_minio_admin
AWS_SECRET_ACCESS_KEY=staging_minio_password
AWS_STORAGE_BUCKET_NAME=amanus-staging-documents
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# --- AI Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCAL_LLM_URL=http://localhost:11434

# --- Next.js Frontend Configuration ---
NEXT_PUBLIC_API_URL=https://staging.amanuslearn.com/api/v1
NEXT_PUBLIC_APP_NAME="Amanus Learn AI (Staging)"
PORT=3000

# --- SaaS Billing (Staging uses mock or stripe test mode) ---
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Security, SSL & Monitoring ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://staging.amanuslearn.com,https://api-staging.amanuslearn.com
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.5
RETENTION_DAYS=7
